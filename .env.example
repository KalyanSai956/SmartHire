APP_ENV=development

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

GROQ_API_KEY=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

LLM_CREDENTIAL_ENCRYPTION_KEY=

PLATFORM_AI_TOKEN_LIMIT=100000

# ------------------------------------------------------------
# NLP / Embeddings
# ------------------------------------------------------------
# SmartHire uses the lightweight production NLP stack:
#
# spaCy: en_core_web_sm
# Semantic embeddings: FastEmbed / ONNX
# Embedding model: all-MiniLM-L6-v2
#
# Models are included in the Docker image.
# PyTorch and Sentence Transformers are not required.

REDIS_ENABLED=false
REDIS_REQUIRED=false
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT=2.0

JOB_CACHE_TTL_SECONDS=60
COMPANY_CACHE_TTL_SECONDS=600
JOB_RECOMMENDATION_CACHE_TTL_SECONDS=120

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_RESUME_ANALYSIS=5
RATE_LIMIT_JOB_RECOMMENDATIONS=20
RATE_LIMIT_RESUME_SEARCH=30
RATE_LIMIT_PDF=10
RATE_LIMIT_HISTORY_PDF=10
RATE_LIMIT_PROFILE_RESUME=5
RATE_LIMIT_LLM_CONNECT=5