# Copy to .env for local development. Never commit real values.

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_API_BASE_URL=/api

# Production origin of THIS frontend, used for canonical / Open Graph / Twitter
# URLs and the share-image URL. Origin only: https scheme, no path, no trailing
# slash. Required for `npm run build`.
# On Vercel you can set it in Project -> Settings -> Environment Variables.
# (If unset on Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically.)
VITE_SITE_URL=https://your-production-domain.tld
